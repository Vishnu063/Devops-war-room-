# Names only; inject real values privately. Never commit a populated file.
NODE_ENV=development
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
# DATABASE_URL=private disposable PostgreSQL URL
# DATA_ENCRYPTION_KEY=private 64-character hex, generate once and preserve securely
COD_ENABLED=false
COD_MAX_PAISE=5000000
# DELIVERY_PIN_PREFIXES=approved comma-separated Indian PIN prefixes
RETURN_WINDOW_DAYS=7
AUTH_RATE_MAX=8
RUN_JOBS=true
SEO_INDEXABLE=false
# PRODUCT_IMAGE_HOSTS=approved.example
# RAZORPAY_KEY_ID=private sandbox key ID
# RAZORPAY_KEY_SECRET=private sandbox secret
# RAZORPAY_WEBHOOK_SECRET=private webhook secret
ALLOW_LIVE_PAYMENTS=false
# SMTP_URL=private TLS-enabled SMTP URL
# MAIL_FROM=approved sender
